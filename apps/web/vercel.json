{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:first(queue|cases|network|agreements|audit|admin|supplier|ops)/:rest*", "destination": "/app/:first/:rest*", "permanent": false },
    { "source": "/:first(queue|cases|network|agreements|audit|admin|supplier|ops)", "destination": "/app/:first", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nodal-accord-api.onrender.com/api/:path*" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" }
  ]
}
