# Placeholders only. Never put real credentials here.
NODAL_ENV=local                 # local | demo | staging | production (production refuses DEMO_MODE)
DEMO_MODE=true                  # seeded fictional principals via X-Demo-Principal header
# Generated dataset (read-only). Defaults to ../Nodal_Accord_5000_Supplier_Data/data/synthetic/generated/tiny
# NODAL_DATA_ROOT=../Nodal_Accord_5000_Supplier_Data/data/synthetic/generated/enterprise_5000
# NODAL_DB_URL=sqlite:///var/nodal_tiny.db
NODAL_INLINE_WORKER=false       # true = solve in an API thread instead of the separate worker process

# Optional AI assistant (off when DEEPSEEK_API_KEY is empty). Never commit a real key.
DEEPSEEK_API_KEY=
NODAL_AI_MODEL=deepseek-flash
NODAL_AI_ACCESS_CODE=           # set on public deployments so only people you give the code to can use your balance
NODAL_AI_HOURLY_LIMIT=30
